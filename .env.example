# Copy to .env.local for local development. Never commit a real env file.
# All of these are read on the server at request time; nothing here is exposed
# to the browser.

# Base URL of parcelpulse-api as seen from the Next.js server.
API_BASE_URL=http://localhost:8000

# Developer controls at /dev drive the carrier simulator. Leave disabled
# anywhere that is not a development environment.
ENABLE_DEV_TOOLS=true
SIMULATOR_BASE_URL=http://localhost:8100
