# Copy to .env to override the defaults used by docker-compose.yml.
# Every value here is a local-development default. Never commit a real .env file.

# --- Host ports -------------------------------------------------------------
# PostgreSQL is published on 15432 by default so it does not clash with a
# PostgreSQL installed directly on the host (5432). Keep host ports below
# 49152: Windows reserves blocks of the range above it.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=6379
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=parcelpulse
POSTGRES_PASSWORD=parcelpulse
POSTGRES_DB=parcelpulse
