# Copy to .env for local development. Never commit a real .env file.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver).
# The value below matches the local stack started from parcelpulse-infra.
DATABASE_URL=postgresql+psycopg://parcelpulse:parcelpulse@localhost:15432/parcelpulse

# Comma-separated carrier codes that shipments may be registered for.
SUPPORTED_CARRIERS=simcarrier

# Redis broker used to hand notifications to parcelpulse-worker. The queue and
# actor names are a contract with the worker; change them in both places or not at all.
REDIS_URL=redis://localhost:6379/0
NOTIFICATION_QUEUE_NAME=notifications
NOTIFICATION_ACTOR_NAME=deliver_notification

# Carrier webhook authentication. The secret is shared with the carrier (locally:
# the carrier simulator) and must be at least 16 characters. Generate a real one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SIGNATURE_REQUIRED=true
WEBHOOK_SIGNING_SECRET=replace-with-a-generated-secret
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_MAX_FUTURE_SKEW_SECONDS=3600

# Development/debug endpoints under /dev. Rejected at startup when ENVIRONMENT=production.
ENABLE_DEV_ENDPOINTS=true

# Integration tests only: database that is dropped and rebuilt on every test run.
# Its name must end with "_test".
# TEST_DATABASE_URL=postgresql+psycopg://parcelpulse:parcelpulse@localhost:25432/parcelpulse_test
# Integration tests only: Redis database that is flushed by the tests.
# TEST_REDIS_URL=redis://localhost:26379/15
