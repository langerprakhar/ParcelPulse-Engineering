# Copy to .env to override the defaults used by docker-compose.yml.
# Every value here is a local-development default. Never commit a real .env file.

# --- Component directories --------------------------------------------------
# Build contexts, relative to this directory. The defaults are the component
# directories of this repository.
API_REPO=../api
WORKER_REPO=../worker
WEB_REPO=../web

# --- Host ports -------------------------------------------------------------
# PostgreSQL is published on 15432 by default so it does not clash with a
# PostgreSQL installed directly on the host (5432). Keep host ports below
# 49152: Windows reserves blocks of the range above it.
WEB_HOST_PORT=3000
API_HOST_PORT=8000
SIMULATOR_HOST_PORT=8100
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=6379
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=parcelpulse
POSTGRES_PASSWORD=parcelpulse
POSTGRES_DB=parcelpulse

# --- Carrier webhooks -------------------------------------------------------
# Shared between the API (verifies) and the carrier simulator (signs).
# At least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SIGNING_SECRET=local-development-only-webhook-secret
