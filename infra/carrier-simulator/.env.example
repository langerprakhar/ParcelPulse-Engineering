# Copy to .env when running the simulator outside Docker. Never commit a real .env file.

LOG_LEVEL=INFO

# Sent as "provider" in every webhook; must be a carrier ParcelPulse supports.
CARRIER_CODE=simcarrier

# Where tracking events are delivered, and the secret shared with ParcelPulse
# (the API's WEBHOOK_SIGNING_SECRET).
WEBHOOK_URL=http://localhost:8000/webhooks/carrier
WEBHOOK_SIGNING_SECRET=replace-with-the-api-webhook-secret

# Carrier-style retries for deliveries that fail.
WEBHOOK_MAX_ATTEMPTS=4
WEBHOOK_RETRY_BACKOFF_SECONDS=0.5
WEBHOOK_TIMEOUT_SECONDS=5

# Used only when asked to register a simulated shipment in ParcelPulse.
PARCELPULSE_API_URL=http://localhost:8000
