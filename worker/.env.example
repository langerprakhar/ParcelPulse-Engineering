# Copy to .env for local development. Never commit a real .env file.

LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# The database owned by parcelpulse-api (SQLAlchemy URL, psycopg 3 driver).
# The value below matches the local stack started from infra/.
DATABASE_URL=postgresql+psycopg://parcelpulse:parcelpulse@localhost:15432/parcelpulse

# Queue contract with parcelpulse-api. Change the names in both places or not at all.
REDIS_URL=redis://localhost:6379/0
NOTIFICATION_QUEUE_NAME=notifications
NOTIFICATION_ACTOR_NAME=deliver_notification

# Email delivery: smtp | log ("log" writes messages to the log instead of sending).
# Locally, SMTP points at the Mailpit sink in the infra/ stack (UI on http://localhost:8025).
EMAIL_PROVIDER=smtp
EMAIL_FROM=ParcelPulse <notifications@parcelpulse.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# Leave both empty for a server without authentication.
SMTP_USERNAME=
SMTP_PASSWORD=

# Base URL of parcelpulse-web, used for links in messages.
WEB_BASE_URL=http://localhost:3000

# Retry policy: attempt n+1 runs base * 2^(n-1) seconds after attempt n fails, capped at max.
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600

# A notification left in SENDING longer than this is treated as abandoned by the sweeper.
SENDING_LEASE_SECONDS=120
SWEEP_INTERVAL_SECONDS=15
SWEEP_GRACE_SECONDS=30
SWEEP_BATCH_SIZE=100

# Tests only: database whose tables are dropped and recreated. Its name must end with "_test".
# TEST_DATABASE_URL=postgresql+psycopg://parcelpulse:parcelpulse@localhost:25433/parcelpulse_worker_test
